PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wishly_auth
NODE_ENV=development

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=86400

ADMIN_EMAIL=admin@wishly.local
ADMIN_PASSWORD=admin-change-me
ADMIN_DISPLAY_NAME=Admin

# Optional: comma-separated Kafka brokers. If unset/unavailable, publish is a no-op.
KAFKA_BROKERS=
KAFKA_CLIENT_ID=auth-service
KAFKA_TOPIC_AUTH_EVENTS=wishly.auth.events
