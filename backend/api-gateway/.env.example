PORT=8080
NODE_ENV=development

# Upstream services (Docker network hostnames in Compose)
AUTH_SERVICE_URL=http://auth-service:3001
WISHLIST_SERVICE_URL=http://wishlist-service:3002
BOOKING_SERVICE_URL=http://booking-service:3003
NOTIFICATION_SERVICE_URL=http://notification-service:3004

# Same secret as auth-service. When set and JWT_VALIDATE_AT_EDGE=true, gateway verifies JWT.
JWT_SECRET=change-me-in-production
JWT_VALIDATE_AT_EDGE=true

# Comma-separated SPA origins (Vite 5173 / preview 4173 / nginx)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:3000,http://localhost
