# Optional: copy to backend/.env so Compose substitutes ${VAR} (defaults work without it):
#   cp .env.example .env
#   docker compose up --build

# Shared JWT (auth-service + api-gateway + other services)
JWT_SECRET=change-me-shared-local-secret
JWT_EXPIRES_IN=86400
JWT_VALIDATE_AT_EDGE=true

# Auth admin seed (auth-service)
ADMIN_EMAIL=admin@wishly.local
ADMIN_PASSWORD=admin-change-me
ADMIN_DISPLAY_NAME=Admin

# PostgreSQL (single instance, four databases — see postgres/init-databases.sql)
POSTGRES_USER=wishly
POSTGRES_PASSWORD=wishly
POSTGRES_DB=postgres

# Kafka (compose service name)
KAFKA_BROKERS=kafka:9092

# SMTP / Mailpit
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=noreply@wishly.local
SMTP_SECURE=false

# Gateway CORS (SPA)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:3000,http://localhost
